# Browser-safe Supabase project connection. RLS must stay enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only: never prefix a Gemini secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public development services need no API keys; configure your own services for production.
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
